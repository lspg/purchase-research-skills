{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Purchase Research Requirements",
  "type": "object",
  "required": [
    "schema_version",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "category": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "requirements": {
      "type": "object",
      "properties": {
        "mandatory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "important": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "desirable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "value": {},
        "unit": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}